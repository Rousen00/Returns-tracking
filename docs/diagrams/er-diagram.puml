@startuml
hide circle
skinparam linetype ortho

entity "users\n(Пользователи)" as users {
  * user_id : INTEGER <<PK>>
--
  * full_name : TEXT
  * login : TEXT
  * password : TEXT
  * role : TEXT
}

entity "products\n(Товары)" as products {
  * product_id : INTEGER <<PK>>
--
  * name : TEXT
  * price : REAL
  * stock_qty : INTEGER
}

entity "sales\n(Продажи / чеки)" as sales {
  * sale_id : INTEGER <<PK>>
--
  * receipt_number : TEXT
  * sale_date : TEXT
  * cashier_id : INTEGER <<FK>>
}

entity "sale_items\n(Позиции чека)" as sale_items {
  * sale_item_id : INTEGER <<PK>>
--
  * sale_id : INTEGER <<FK>>
  * product_id : INTEGER <<FK>>
  * quantity : INTEGER
  * price : REAL
}

entity "returns\n(Возвраты)" as returns {
  * return_id : INTEGER <<PK>>
--
  * sale_id : INTEGER <<FK>>
  * cashier_id : INTEGER <<FK>>
manager_id : INTEGER <<FK>>
  * return_date : TEXT
  * reason : TEXT
  * status : TEXT
refund_amount : REAL
}

entity "return_items\n(Позиции возврата)" as return_items {
  * return_item_id : INTEGER <<PK>>
--
  * return_id : INTEGER <<FK>>
  * sale_item_id : INTEGER <<FK>>
  * quantity : INTEGER
is_good_condition : INTEGER
restock : INTEGER
}

users ||--o{ sales : "оформляет"
users ||--o{ returns : "принимает (кассир)"
users |o--o{ returns : "решает (менеджер)"
sales ||--|{ sale_items : "содержит"
products ||--o{ sale_items : "входит в"
sales ||--o{ returns : "по чеку"
returns ||--|{ return_items : "содержит"
sale_items ||--o{ return_items : "возвращается"
@enduml